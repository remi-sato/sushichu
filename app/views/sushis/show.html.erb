<div class="container">
  <div class="row align-items-center py-4">
    <div class="col-6">
      <% if @sushi.image.attached? %>
        <%= image_tag @sushi.image, class: "img-fluid" %>
      <% end %>
    </div>

    <div class="col-6">
      <h1 class="mb-3"><%= @sushi.name %></h1>
      <p class="fs-4 fw-bold"><%= @sushi.price %>円</p>
      <p class="mb-4"><%= @sushi.description %></p>

      <div>
        <%= form_with url: order_items_path,
                method: :post,
                class: "d-flex align-items-center gap-2 mb-3" do |form| %>

          <%= form.hidden_field :sushi_id, value: @sushi.id %>

          <%= form.label :quantity, "数量", class: "text-nowrap" %>

          <%= form.select :quantity,
                options_for_select(1..10),
                {},
                class: "form-select w-auto" %>

          <%= form.submit "カートへ追加",
                class: "btn btn-outline-primary text-nowrap" %>
        <% end %>

        <%= link_to "一覧へ戻る",
              sushis_path,
              class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>