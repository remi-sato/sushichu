<div class="container py-4">
  <h1 class="mb-4">厨房・注文一覧</h1>

  <% if @order_items.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>商品</th>
            <th>数量</th>
            <th>ステータス</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @order_items.each do |order_item| %>
            <tr>
              <td><%= order_item.sushi.name %></td>
              <td><%= order_item.quantity %>個</td>

              <td>
                <% if order_item.completed? %>
                  <span class="badge text-bg-success">提供済</span>
                <% else %>
                  <span class="badge text-bg-warning">注文済</span>
                <% end %>
              </td>

              <td class="text-end">
                <% if order_item.ordered? %>
                  <%= button_to "提供済にする",
                        kitchen_order_item_path(order_item),
                        method: :patch,
                        class: "btn btn-success btn-sm",
                        data: {
                          turbo_confirm: "この商品を提供済にしますか？"
                        } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-muted">対応中の商品はありません。</p>
  <% end %>
</div>